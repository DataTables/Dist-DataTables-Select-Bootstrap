{
    "name": "datatables.net-select-bs",
    "description": "Select for DataTables with styling for [Bootstrap](https://getbootstrap.com/docs/3.3/)",
    "main": "./js/select.bootstrap.js",
    "module": "./js/select.bootstrap.mjs",
    "style": "./css/select.bootstrap.css",
    "types": "./types/select.bootstrap.d.ts",
    "version": "4.1.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "select",
        "selection",
        "Bootstrap",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-select": "4.1.0",
        "datatables.net-bs": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/Select.git"
    },
    "exports": {
        ".": {
            "types": "./types/select.bootstrap.d.ts",
            "import": "./js/select.bootstrap.mjs",
            "default": "./js/select.bootstrap.mjs",
            "require": "./js/select.bootstrap.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/select.bootstrap.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}